</tr>
<tr>
<td><code>17</code></td>
<td><code>uniqueKey</code></td>
<td><code>uniqueKey</code></td>
<td><code>String</code></td>
<td>Trimmed string (Primary correlation key between Header, Paylog, and CPT)</td>
</tr>
<tr>
<td><code>18</code></td>
<td><code>deductibleAmount</code></td>
